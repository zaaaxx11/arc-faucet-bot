# Captcha solving service API key (2captcha, sctg.xyz, etc.)
CAPTCHA_API_KEY=your_captcha_api_key_here

# Captcha service base URL
CAPTCHA_BASE=https://2captcha.com

# Path to wallets JSON file
WALLETS_FILE=wallets.json

# Output log file
LOG_FILE=faucet_claim_log.json

# Delay between claims (seconds)
CLAIM_DELAY=10
